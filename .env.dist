LOG_LEVEL=INFO

HTTP_LISTEN_ADDR=:8080
SQLITE_PATH=./minilab-dashboard.db
MDNS_AGENT_SERVICE_NAME=_minilab-agent._tcp
DISCOVERY_INTERVAL=1m
POLL_INTERVAL=15s
UNREACHABLE_THRESHOLD=3

# Mutual TLS -- set all three or none. One private CA signs this dashboard, every agent and
# every browser client certificate.
TLS_CA_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
