LOG_LEVEL=INFO

HTTP_LISTEN_ADDR=:8080
SQLITE_PATH=./minilab-dashboard.db
MDNS_AGENT_SERVICE_NAME=_minilab-agent._tcp
DISCOVERY_INTERVAL=1m
POLL_INTERVAL=15s
UNREACHABLE_THRESHOLD=3

# Mutual TLS, one private CA for everything (see README). Each pair is optional:
# TLS_CLIENT_*  = certificate (clientAuth) the dashboard shows to agents; also switches
#                 agent calls to https. Needs TLS_CA_FILE.
# TLS_CERT/KEY  = certificate (serverAuth) for the web UI; serves https and requires a
#                 client certificate from every browser. Needs TLS_CA_FILE.
TLS_CA_FILE=
TLS_CLIENT_CERT_FILE=
TLS_CLIENT_KEY_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
